{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@mn/tokens": ["./packages/tokens/src/index.ts"],
      "@mn/tokens/*": ["./packages/tokens/src/*"],
      "@mn/ui": ["./packages/ui/src/index.ts"],
      "@mn/ui/*": ["./packages/ui/src/*"],
      "@mn/content": ["./packages/content/src/index.ts"],
      "@mn/content/*": ["./packages/content/src/*"],
      "@mn/seo": ["./packages/seo/src/index.ts"],
      "@mn/seo/*": ["./packages/seo/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", ".migration-reference", "artifacts", "migration-orchestration"]
}
