# Máquina Nerd — variáveis de ambiente
#
# Copie para `.env.local` e preencha. `.env*` é ignorado pelo git; nenhum valor real
# deste arquivo deve ser commitado.
#
# A validação roda em `packages/content/src/env.ts` e é deliberadamente rígida em
# produção: um erro de configuração vira uma falha de boot legível, não um site que
# parece certo e serve conteúdo errado.

# ------------------------------------------------------------------ ambiente

# Nomeia o *deployment*, que não é a mesma coisa que NODE_ENV — `next build` sempre
# define NODE_ENV=production. Ausente, cai para NODE_ENV, então um deploy real que
# esquecer esta variável continua com todas as travas de produção.
# development | test | staging | production
APP_ENV=development

# URL canônica, sem barra final. Obrigatoriamente https em produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# `kalel` em produção. `fixture` só é aceito quando APP_ENV não é production —
# um provider de fixtures servindo leitores é pior que uma queda: parece certo.
CONTENT_SOURCE=fixture

# ------------------------------------------------------------------- Kal El
# Tudo abaixo é server-only. Nada aqui pode alcançar o bundle do cliente.

KAL_EL_BASE_URL=http://localhost:3001
KAL_EL_SITE_ID=
# Escopos mínimos de entrega: articles.read, media.read, taxonomy.*.manage (leitura),
# seo.manage (leitura de redirects). Ver docs/migration/KAL-EL-DISCOVERY.md.
KAL_EL_SERVICE_TOKEN=
# Segredo compartilhado do webhook. Mínimo de 32 caracteres em produção.
KAL_EL_WEBHOOK_SECRET=
# Assina o grant de preview emitido por este app. Mínimo de 32 caracteres em produção.
KAL_EL_PREVIEW_SECRET=
KAL_EL_TIMEOUT_MS=5000

# ---------------------------------------------------------------------- mídia
# Allowlist explícita de hosts remotos de imagem. Vazio significa "nenhuma imagem
# remota", e o proxy autenticado em /media/[id] atende. Sem curinga: um loader de
# imagem aberto é um proxy de imagem aberto.
MEDIA_ALLOWED_HOSTS=

# ------------------------------------------------------------------ operação

# Obrigatório e explícito em produção. O rate limit agrupa por endereço do cliente:
# confiar em x-forwarded-for sem proxy deixa qualquer chamador forjar um balde
# privado; ignorá-lo com proxy junta todos os visitantes em um balde só. Com o proxy,
# vale a entrada que ele escreveu; se ela for do Cloudflare, o CF-Connecting-IP.
TRUST_PROXY=false

RATE_LIMIT_MAX=60
LOG_LEVEL=info
SENTRY_DSN=

# Provedor de newsletter. Enquanto ausente, /api/newsletter responde 501 e o formulário
# mostra um erro real — em vez de fingir uma inscrição que ninguém recebeu.
NEWSLETTER_PROVIDER_URL=
NEWSLETTER_PROVIDER_TOKEN=

# Build de contêiner: `standalone` gera o server.js que a imagem roda (Dockerfile).
# Deixe vazio no Windows — o trace cria symlinks que exigem o Modo Desenvolvedor.
NEXT_OUTPUT=

# --------------------------------------------- provisionamento (operador, nunca runtime)
# Usadas só por `pnpm kalel:provision`, uma vez, antes do primeiro deploy. Não coloque
# no ambiente do contêiner.
KALEL_ADMIN_EMAIL=
KALEL_ADMIN_PASSWORD=
PORTAL_PUBLIC_URL=

# ------------------------------------------------- somente importação (nunca runtime)
# O WordPress é origem de leitura. Nada nesta seção é lido pelo site em execução.

# --source rest: o WordPress no ar.
WP_BASE_URL=
# Application password, no formato usuario:senha. Nunca aparece em log.
WP_APPLICATION_PASSWORD=

# --source archive: um dump SQL, lido direto. Não abre conexão de rede nenhuma.
# Aceita .sql e .sql.gz.
WP_ARCHIVE_DUMP=
# `wp-content/uploads` extraído. Sem ele nenhum byte de mídia é transferido.
WP_UPLOADS_DIR=
# Só se as tabelas não usarem o prefixo padrão `wp_`.
WP_TABLE_PREFIX=
