# Public/canonical
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTENT_SOURCE=fixture

# Kal El (server-only; use real values only in protected environment stores)
KAL_EL_BASE_URL=http://localhost:4000/api/v1
KAL_EL_SERVICE_TOKEN=replace-with-server-only-token
KAL_EL_WEBHOOK_SECRET=replace-with-long-random-secret
KAL_EL_PREVIEW_SECRET=replace-with-long-random-secret

# Optional internal Cinerie integration (server-only)
CINERIE_INTERNAL_URL=
CINERIE_SERVICE_TOKEN=

# Migration-only WordPress source (never used by runtime)
WP_BASE_URL=
WP_APPLICATION_PASSWORD=

# Comma-separated, no wildcards or private hosts in production
MEDIA_ALLOWED_HOSTS=images.example.com

# Optional observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
